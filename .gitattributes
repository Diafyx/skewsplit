* text=auto eol=lf

# Generated files. They are collapsed in diffs and do not count towards the PR
# size label, so this list is the only place size exclusions are defined.
# Generated Markdown (the changelogs release-please writes) is also left out
# of the Markdown lint and link checks in `make docs`.
uv.lock linguist-generated=true
Cargo.lock linguist-generated=true
spec/fixtures/** linguist-generated=true
**/snapshots/** linguist-generated=true
**/__snapshots__/** linguist-generated=true
python/CHANGELOG.md linguist-generated=true
bench/RESULTS.md linguist-generated=true
