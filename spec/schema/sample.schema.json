{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Diafyx/skewsplit/blob/main/spec/schema/sample.schema.json",
  "title": "skewsplit sample fixture",
  "description": "A sample of one column and the table's estimated rows, and the planner input or error every implementation must build from them, as defined in spec/SPEC.md section 14. Warning and error messages are left out: their wording is not part of the contract.",
  "type": "object",
  "required": ["description", "input", "expected"],
  "properties": {
    "description": {
      "description": "How the expected result follows from the spec, with the arithmetic.",
      "type": "string",
      "minLength": 1
    },
    "input": true,
    "expected": true
  },
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "input": {"$ref": "#/$defs/sample"},
        "expected": {"$ref": "#/$defs/converted"}
      }
    },
    {
      "description": "An error fixture. Its input is invalid on purpose, so it may be any JSON value.",
      "properties": {
        "expected": {"$ref": "#/$defs/error"}
      }
    }
  ],
  "$defs": {
    "count": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "type": {"enum": ["int2", "int4", "int8", "numeric", "date", "timestamp", "timestamptz"]},
    "spec_version": {"const": "1.1"},
    "sample": {
      "description": "The conversion input of spec section 14.",
      "type": "object",
      "required": [
        "column",
        "type",
        "partitions",
        "rows_estimate",
        "sample_null_rows",
        "sample_values"
      ],
      "properties": {
        "column": {"type": "string"},
        "type": {"$ref": "#/$defs/type"},
        "scale": {"type": "integer", "minimum": 0, "maximum": 1000},
        "partitions": {"type": "integer", "minimum": 1, "maximum": 10000},
        "rows_estimate": {"$ref": "#/$defs/count"},
        "sample_null_rows": {"$ref": "#/$defs/count"},
        "sample_values": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["value", "rows"],
            "properties": {
              "value": {"type": "string"},
              "rows": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "converted": {
      "type": "object",
      "required": ["spec_version", "input"],
      "properties": {
        "spec_version": {"$ref": "#/$defs/spec_version"},
        "input": {
          "description": "A planner input of spec section 1. The conformance tests check that it plans.",
          "type": "object",
          "required": ["column", "type", "partitions", "null_rows", "mcv", "histogram", "source"],
          "properties": {"source": {"$ref": "#/$defs/source"}}
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["statistics", "rows_estimate", "sample_rows", "unestimated_rows", "warnings"],
      "properties": {
        "statistics": {"const": "sample"},
        "rows_estimate": {"$ref": "#/$defs/count"},
        "sample_rows": {"$ref": "#/$defs/count"},
        "unestimated_rows": {"$ref": "#/$defs/count"},
        "warnings": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "type": "object",
            "required": ["code", "rows"],
            "properties": {
              "code": {"const": "special_values_left_out"},
              "rows": {"$ref": "#/$defs/count"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "required": ["spec_version", "error"],
      "properties": {
        "spec_version": {"$ref": "#/$defs/spec_version"},
        "error": {
          "type": "object",
          "required": ["code"],
          "properties": {
            "code": {
              "enum": [
                "invalid_input",
                "invalid_rows",
                "invalid_value",
                "value_out_of_range",
                "duplicate_value",
                "unsupported_type",
                "invalid_partitions",
                "invalid_column"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
